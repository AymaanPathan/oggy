# Oggy: one .gitignore for the whole repo
# (backend/, frontend/, vscode-bridge/, landing/).
# Patterns without a leading slash match in every folder.

# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.npm/
.yarn/

# ---------- Build output ----------
# frontend: electron-vite build
out/
# backend: tsc build
dist/
# pnpm dist: build/oggy (bundled backend) and build/installer (Oggy-Setup.exe)
/build/
# electron-builder leftovers
release/
*.tsbuildinfo
.vite/
.cache/

# ---------- Secrets and local config ----------
# Oggy's real settings live in ~/.oggy/config.json and hold its Switch key.
# A copy must never be committed. switch/config.example.json is the template.
backend/src/config.json
config.json.before-lock
.env
.env.*
!.env.example
*.pem
*.key
# Owner token, in case OGGY_DATA_DIR ever points inside the repo
token
.oggy/

# ---------- SQLite (runs, approvals, workflows, memory) ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- Logs ----------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Tests and coverage ----------
coverage/
.nyc_output/
test-results/
playwright-report/

# ---------- Editors ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
