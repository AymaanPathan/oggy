{
  "compilerOptions": {
    "composite": true,
    "rootDir": "..",
    "outDir": "out/.tsc/node",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./../backend/src/shared/*"],
      "@common/*": ["./src/common/*"]
    }
  },
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/common/**/*", "../backend/src/shared/**/*"]
}
