{
  "compilerOptions": {
    "composite": true,
    "rootDir": "..",
    "outDir": "out/.tsc/web",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@shared/*": ["./../backend/src/shared/*"],
      "@common/*": ["./src/common/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/common/**/*", "src/preload/*.d.ts", "../backend/src/shared/**/*"]
}
