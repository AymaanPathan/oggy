# Most settings live in ~/.oggy/config.json (see switch/config.example.json).
# These override it, which is handy for a second setup or for tests.
OGGY_PORT=4317
# Where SQLite db + auth token live (default: ~/.oggy)
OGGY_DATA_DIR=
# Root folder for your projects (default: paths.codeFolder, else ~/Projects). "my portfolio" -> <folder>/portfolio
OGGY_PROJECTS_DIR=

# Switch (override switch.* and rooms.team in config.json)
SWITCH_API_URL=
SWITCH_AGENT_ID=
SWITCH_API_KEY=
SWITCH_ROOM_ID=

# Render API key: lets Oggy fetch a live project's logs for the agents
RENDER_API_KEY=

# Not used yet
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
