# Oggy — common .gitignore for frontend/ (Electron + Vite + React) and backend/ (Node + SQLite)
# Patterns without a leading slash match in every folder.

# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.yarn/
.npm/

# ---------- Build output ----------
# electron-vite build (frontend)
out/
# tsc build (backend) / electron-builder output
dist/
release/
build/
*.tsbuildinfo
.vite/
.cache/

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
# owner token, if OGGY_DATA_DIR ever points inside the repo
token

# ---------- SQLite (memory, workflows, runs) ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.oggy/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Test & coverage ----------
coverage/
.nyc_output/
playwright-report/
test-results/

# ---------- Editors ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini